# ================================================================
# ORBIT-I Private Limited - Server & MySQL Database Configuration
# Enterprise Production Ready (Linux VPS / Cloud Engine / Containers)
# ================================================================

# Application Port
PORT=3000
NODE_ENV=production

# Application Base URL
APP_URL=https://orbit-i.tech

# Security: Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=https://orbit-i.tech,https://www.orbit-i.tech

# ================================================================
# Authentication & Access Control (Master Credentials)
# Set strong, high-entropy secrets in production environment
# ================================================================
ADMIN_EMAIL=admin@orbit-i.tech
ADMIN_PASSWORD=your_strong_admin_password_here
ADMIN_PORTAL_KEY=your_secret_admin_master_key

CLIENT_EMAIL=client@yourcompany.com
CLIENT_PASSWORD=your_strong_client_password_here

# Cryptographic Session Vault Secret
SESSION_SECRET=your_cryptographic_session_secret_min_32_chars

# ================================================================
# MySQL Database Configuration (Production MySQL / MariaDB)
# ================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=orbit_db_user
DB_PASSWORD=your_strong_mysql_password
DB_NAME=orbit_production_db

# MySQL Connection Pool Limit (Recommended: 10 - 25)
DB_CONNECTION_LIMIT=10
